# 在线多模态模型配置（GLM 开放平台 https://open.bigmodel.cn 获取 API Key）
ONLINE_API_KEY=在此填入你的API_KEY
# 模型名，如 glm-5.3-flash / glm-4.5v 等
ONLINE_MODEL=glm-5.3-flash
# OpenAI 兼容端点
ONLINE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 思考配置：
#   off  = 关闭思考（仅部分模型支持；glm-5.3-flash 不支持，会报 1210 错误）
#   on   = 默认强度开启
#   low / high / max = "始终思考"型模型的思考速度档位（max = 最强推理，最慢最贵）
ONLINE_THINKING=max
# 读响应超时秒数（流式心跳语义）：流式响应字节流不断 = 服务端活着，
# 该值 = "两次字节之间的最大间隔"。服务端间歇性挂起时字节流中断，
# 几十秒即可判定 → 自动重试一次恢复。智谱 max 档思考期也持续推流，
# 60s 间隔裕量充足；若观察到思考期字节间隔偏长可调大
ONLINE_TIMEOUT=60
# 思考+作答的单次生成预算。0 = 不传该字段（框架不设上限，交由服务端
# 模型输出上限兜底——始终思考型模型推荐）；正值 = 单次响应生成硬顶
# （思考耗尽预算会输出空答案，finish_reason=length）
ONLINE_MAX_TOKENS=0

# Ollama 本地模型配置（与 ONLINE_* 二选一使用，脚本 --llm 参数切换）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120

# OCR 配置（RapidOCR 优先，easyocr 为回退）
OCR_LANGUAGES=ch_sim,en
OCR_USE_GPU=false

# 脚本输出路径（用户安装时自选的路径，脚本直接保存到此目录）
SCRIPTS_OUTPUT_DIR=./output

# 脚本配置
SCRIPT_PAUSE_INTERVAL=0.5

# 日志级别
LOG_LEVEL=INFO
